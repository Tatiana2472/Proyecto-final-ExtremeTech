APP_NAME="ExtremTech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ventas@extremtech.cr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Configuración de la tienda virtual (config/tienda.php)
# ---------------------------------------------------------------------------
TIENDA_NOMBRE="ExtremTech"
TIENDA_LEMA="Tecnología que rinde, a precio que conviene"
TIENDA_CORREO=ventas@extremtech.cr
TIENDA_TELEFONO="+506 2222-3333"
TIENDA_DIRECCION="San José, Costa Rica"
TIENDA_CEDULA=3-101-123456

# Impuesto (IVA de Costa Rica = 13%) y costos de envío
TIENDA_IMPUESTO_NOMBRE=IVA
TIENDA_IMPUESTO_TASA=0.13
TIENDA_ENVIO_COSTO=2900
TIENDA_ENVIO_GRATIS_DESDE=75000

# Moneda
TIENDA_MONEDA=CRC
TIENDA_MONEDA_SIMBOLO=₡
TIENDA_MONEDA_DECIMALES=0

# Cookie de productos vistos recientemente
TIENDA_VISTOS_MAXIMO=6
TIENDA_VISTOS_DIAS=30

# Catálogo
TIENDA_PRODUCTOS_POR_PAGINA=9

# Pasarelas de pago. Con "sandbox" el cobro se simula (no se envían datos a
# ningún banco). Cambie a "live" y coloque credenciales reales en producción.
TIENDA_PAGOS_MODO=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MONEDA=USD
PAYPAL_TIPO_CAMBIO=510
SINPE_NUMERO=8888-8888

# Certificado SSL: en producción (APP_ENV=production) HTTPS se fuerza solo.
# Póngalo en true para forzarlo también en un entorno de pruebas.
TIENDA_FORZAR_HTTPS=false

# ---------------------------------------------------------------------------
# Importación de catálogo (php artisan catalogo:importar)
# ---------------------------------------------------------------------------
# Dirección de la tienda WooCommerce cuya API pública se va a consumir.
CATALOGO_EXTERNO_URL=
# Identificación del proyecto ante el servidor del otro sitio.
CATALOGO_EXTERNO_USER_AGENT="UTN-ITI523-ProyectoAcademico/1.0"
# Segundos de espera entre página y página, para no cargar el servidor ajeno.
CATALOGO_EXTERNO_PAUSA=2
# Origen alternativo cuando la tienda real bloquea el acceso automatizado.
CATALOGO_DUMMYJSON_URL=https://dummyjson.com
